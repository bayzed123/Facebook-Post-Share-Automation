{
  "manifest_version": 3,
  "name": "FB Auto-Share Automation",
  "version": "1.0",
  "description": "Bridge for Facebook auto-share automation via dashboard events.",
  "permissions": ["tabs", "activeTab", "scripting"],
  "host_permissions": ["https://www.facebook.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["dashboard.js"],
      "run_at": "document_start"
    }
  ]
}
